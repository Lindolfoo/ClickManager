# Copie para .env e preencha. O .env NÃO deve ir para o Git.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_esta_senha

# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_KEY=troque_esta_chave_por_uma_aleatoria_de_32_caracteres_ou_mais

# URL onde o front-end está publicado (usado no link de redefinição e no CORS)
FRONTEND_BASE_URL=http://localhost:5500

# SMTP (Gmail: use uma "senha de app", não a senha da conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=seu@email.com
SMTP_PASSWORD=sua_senha_de_app
ADMIN_EMAIL=admin@seudominio.com
