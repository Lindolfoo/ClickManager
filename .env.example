# ══════════════════════════════════════════════════════════════════
# Template de variáveis de ambiente — ClickManager
#
#   1. Copie este arquivo para `.env` (na raiz do projeto).
#   2. Preencha os valores COM O SEU AMBIENTE — nunca reaproveite os
#      valores de exemplo abaixo, nem em desenvolvimento.
#   3. `.env` já está no .gitignore. NUNCA force o add dele, nem
#      cole segredos reais em commits, PRs, issues ou logs.
#   4. Em produção (Railway ou outro host), essas variáveis são
#      configuradas direto no painel/CLI do provedor — este arquivo
#      é só para rodar localmente com docker-compose.
#
# Se um segredo vazar (commit acidental, log, print de tela): troque
# o valor aqui E na plataforma de produção, e revogue sessões antigas
# (o Jwt:Key novo já invalida todos os tokens emitidos com o antigo).
# ══════════════════════════════════════════════════════════════════

# ── Banco de dados ───────────────────────────────────────────────
POSTGRES_USER=postgres
# Senha forte só para uso local. Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=troque_esta_senha_por_uma_gerada_aleatoriamente

# ── JWT (assinatura dos tokens de autenticação) ──────────────────
# Mínimo 32 caracteres, alta entropia. Gere com: openssl rand -base64 48
# Qualquer pessoa com este valor consegue forjar login de qualquer
# usuário do sistema — trate como a credencial mais sensível do projeto.
JWT_KEY=troque_esta_chave_por_uma_aleatoria_de_32_caracteres_ou_mais

# ── Front-end ─────────────────────────────────────────────────────
# URL onde o front-end está publicado (usado no link de redefinição
# de senha, no link público de galeria e na política de CORS).
FRONTEND_BASE_URL=http://localhost:5500

# ── SMTP (e-mails transacionais: redefinição de senha, contato) ──
# Gmail: crie uma "senha de app" dedicada (myaccount.google.com/apppasswords)
# — nunca use a senha da conta principal aqui.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=seu@email.com
SMTP_PASSWORD=sua_senha_de_app
ADMIN_EMAIL=admin@seudominio.com
